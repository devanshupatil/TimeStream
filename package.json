{
    "name": "timestream",
    "version": "1.1.0",
    "description": "Developer activity tracker",
    "author": "Devanshu Prakash Patil <devanshupatil692@gmail.com>",
    "main": "src/main/index.js",
    "scripts": {
        "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
        "build:renderer": "vite build",
        "build:dist": "bun run build:renderer && electron-builder",
        "build:linux": "bun run build:renderer && electron-builder --linux",
        "build:win": "bun run build:renderer && electron-builder --win",
        "build:mac": "bun run build:renderer && electron-builder --mac",
        "test": "bun test",
        "test:watch": "bun test --watch"
    },
    "devDependencies": {
        "@happy-dom/global-registrator": "^20.9.0",
        "@testing-library/jest-dom": "^6.4.2",
        "@testing-library/react": "^15.0.0",
        "@testing-library/user-event": "^14.6.1",
        "@vitejs/plugin-react": "^4.2.1",
        "concurrently": "^8.2.2",
        "electron": "^29.0.0",
        "electron-builder": "^24.13.3",
        "happy-dom": "^20.9.0",
        "jsdom": "^24.0.0",
        "vite": "^5.2.0",
        "wait-on": "^7.2.0"
    },
    "dependencies": {
        "better-sqlite3": "^9.4.3",
        "electron-updater": "^6.1.8",
        "react": "^18.2.0",
        "react-dom": "^18.2.0"
    }
}
