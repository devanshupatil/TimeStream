{
    "name": "timestream",
    "version": "1.0.0",
    "description": "Automatic Developer Activity Timeline - Desktop App",
    "main": "src/main.js",
    "scripts": {
        "start": "electron . --no-sandbox",
        "dev": "electron . --no-sandbox --dev",
        "build": "electron-builder"
    },
    "keywords": [
        "electron",
        "developer",
        "timeline",
        "activity"
    ],
    "author": "TimeStream",
    "license": "MIT",
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1"
    },
    "build": {
        "appId": "com.timestream.app",
        "productName": "TimeStream",
        "directories": {
            "output": "dist"
        },
        "linux": {
            "target": "AppImage"
        },
        "mac": {
            "target": "dmg"
        },
        "win": {
            "target": "nsis"
        }
    }
}